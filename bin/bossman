#!/bin/sh
# bossman: splits coding work across models by difficulty. See `bossman help`.
#
# Set BOSSMAN_NOTIFY to a command that takes one message, to hear when a run
# ends. For example a script that sends it to your phone.

set -u
here=$(dirname "$(realpath "$0")")
# The agents call `bossman task` and `bossman check`, so this command must be on their PATH.
PATH="$here:$PATH"; export PATH
max_restarts=5

say() { printf 'bossman: %s\n' "$1"; }
notify() {
  say "$1"
  if [ -n "${BOSSMAN_NOTIFY:-}" ]; then "$BOSSMAN_NOTIFY" "$1" || true; fi
}

usage() {
  cat <<'EOF'
Usage:
  bossman init                 Add the agents, opencode.jsonc and bossman.jsonc to this repo
  bossman "<prompt>"           Build it: leader plans the work and hands out tasks
  bossman run "<prompt>"       The same, for a prompt that starts with a command name
  bossman task --tier <junior|senior|expert> --task <n> --spec <path> [--test <cmd>]
                               Run one task in a fresh sandbox
  bossman check [--ref <commit>] [--test <cmd>]
                               Run the full test command on a commit in a fresh sandbox
  bossman help                 Show this
EOF
}

case "${1:-}" in
  help | -h | --help) usage; exit 0 ;;
  task | check)
    command -v bun >/dev/null || { say "bun isn't installed. See the README."; exit 2; }
    sub=$1; shift
    exec bun "$here/../worker/src/worker.ts" "$sub" "$@" ;;
  run) shift ;;
  "") usage; exit 2 ;;
esac

root=$(git rev-parse --show-toplevel 2>/dev/null) || { say "run this inside a git repository"; exit 2; }
cd "$root" || exit 2

if [ "${1:-}" = "init" ]; then
  mkdir -p .opencode/agents specs
  for f in opencode.jsonc bossman.jsonc .opencode/agents/leader.md .opencode/agents/junior.md \
           .opencode/agents/senior.md .opencode/agents/expert.md .opencode/agents/reviewer.md; do
    if [ -e "$f" ]; then say "kept your $f"; else cp "$here/../template/$f" "$f"; say "added $f"; fi
  done
  grep -qx '.bossman/' .gitignore 2>/dev/null || { echo '.bossman/' >> .gitignore; say "added .bossman/ to .gitignore"; }
  exit 0
fi

prompt="${1:-}"
[ -n "$prompt" ] || { say 'give a prompt, like: bossman run "Build a todo app"'; exit 2; }
[ -f .opencode/agents/leader.md ] || { say "run bossman init first"; exit 2; }
command -v opencode >/dev/null || { say "opencode isn't installed. See the README."; exit 2; }
command -v bun >/dev/null || { say "bun isn't installed. See the README."; exit 2; }
for v in LITELLM_BASE_URL LITELLM_API_KEY PYO_URL PYO_API_KEY; do
  eval "val=\${$v:-}"
  [ -n "$val" ] || { say "$v isn't set. See the README."; exit 2; }
done

mkdir -p .bossman/logs
session=""
tries=0
while [ $tries -le $max_restarts ]; do
  log=".bossman/logs/leader-$(date +%Y%m%d-%H%M%S).jsonl"
  if [ -z "$session" ]; then
    say "leader is planning"
    opencode run --standalone --auto --format json --agent leader "$prompt" > "$log"
  else
    say "resuming leader (restart $tries of $max_restarts)"
    opencode run --standalone --auto --format json --agent leader --session "$session" \
      "Continue from PLAN.md. Skip tasks marked done." > "$log"
  fi
  code=$?

  if [ -f PLAN.md ] && tail -n 1 PLAN.md | grep -q 'ALL TASKS DONE'; then
    notify "done. See PLAN.md for what was built and what failed."
    exit 0
  fi

  # Session ids look like ses_4f2a1c. Not confirmed: where run --format json prints it.
  [ -n "$session" ] || session=$(grep -o 'ses_[A-Za-z0-9]*' "$log" | head -n 1)

  if grep -qi 'budget' "$log"; then
    notify "stopped: the LiteLLM budget is used up. Raise it, then run the same command again."
    exit 3
  fi
  if grep -qi 'rate limit\|overloaded' "$log"; then
    say "a provider is rate limiting. Waiting 5 minutes."
    sleep 300
  fi
  [ $code -eq 0 ] || say "leader stopped with exit code $code. Log: $log"
  tries=$((tries + 1))
done

notify "stopped after $max_restarts restarts. See PLAN.md and .bossman/logs."
exit 1
